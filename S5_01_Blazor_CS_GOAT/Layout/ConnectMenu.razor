@using S5_01_Blazor_CS_GOAT.ViewModels
@inject ConnectMenuViewModel ViewModel
@implements IDisposable

<div class="connect-btn">
    <div class="style-btn">
        <svg viewBox="-2.4 -2.4 28.80 28.80" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- SVG content -->
        </svg>
        @if (ViewModel.CurrentUser != null)
        {
            <label class="menu">
                @ViewModel.CurrentUser.DisplayName
                <input class="inp" checked="" type="checkbox" />
                <div class="bar">
                    <span class="top bar-list"></span>
                    <span class="middle bar-list"></span>
                    <span class="bottom bar-list"></span>
                </div>
                <section class="menu-container">
                    @if (ViewModel.CurrentUser?.IsAdmin == true)
                    {
                        <div class="menu-list" @onclick="ViewModel.NavigateToAdmin" style="cursor: pointer;">Admin Panel</div>
                    }
                    <div class="menu-list" @onclick="ViewModel.NavigateToProfile" style="cursor: pointer;">Profile</div>
                    <div class="menu-list" @onclick="ViewModel.NavigateToWallet" style="cursor: pointer;">Portefeuille : @ViewModel.CurrentUser.Wallet.ToString("F2")€</div>
                    <div class="menu-list" @onclick="async () => await ViewModel.HandleLogoutAsync()" style="cursor: pointer;">Déconnexion</div>
                </section>
            </label>
        }
        else
        {
            <button class="button" data-text="Awesome" @onclick="ViewModel.NavigateToLogin">
                <span class="actual-text">&nbsp;connexion&nbsp;</span>
                <span aria-hidden="true" class="hover-text">&nbsp;connexion&nbsp;</span>
            </button>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("🔧 ConnectMenu initializing...");
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += OnPropertyChanged;
        Console.WriteLine($"👤 ConnectMenu initialized with user: {ViewModel.CurrentUser?.DisplayName ?? "null"}");
    }

    private void OnPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e)
    {
        Console.WriteLine($"🔔 Property changed: {e.PropertyName}");
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnPropertyChanged;
        ViewModel.Dispose();
    }
}