@page "/viewModel/{InventoryItemId:int}"
@using HomagGroup.Blazor3D.Viewers
@using S5_01_Blazor_CS_GOAT.Service
@using S5_01_Blazor_CS_GOAT.ViewModels
@using Radzen
@using Radzen.Blazor
@using Shared.DTO
@using S5_01_Blazor_CS_GOAT.Layout
@implements IDisposable
@inject ThreeDViewViewModel ViewModel
@inject NavigationManager NavigationManager
@inject AuthService AuthService

<!-- Popup de confirmation de vente -->
@if (showConfirmationPopup)
{
    <div class="popup-backdrop">
        <div class="popup-modal">
            <h3>Confirmer la vente</h3>
            <p class="confirmation-item-name">@confirmationItemName</p>
            <p class="confirmation-price-text">Prix de vente: @confirmationPrice</p>
            
            @if (isSecondConfirmation)
            {
                <div class="warning-message">
                    <span class="warning-icon">⚠️</span>
                    <p>ATTENTION : Cette arme est dans vos favoris !</p>
                </div>
            }
            
            <p>@(isSecondConfirmation ? "Êtes-vous absolument sûr de vouloir vendre cette arme ?" : "Voulez-vous vraiment vendre cette arme ?")</p>
            
            <div style="display: flex; gap: 10px; justify-content: center; margin-top: 20px;">
                <button class="popup-close" @onclick="ConfirmSell" style="background-color: #4CAF50;">Confirmer</button>
                <button class="popup-close" @onclick="CancelSell" style="background-color: #f44336;">Annuler</button>
            </div>
        </div>
    </div>
}

<!-- Overlay de chargement pour la vente -->
@if (isSellingItem)
{
    <div class="popup-backdrop">
        <div class="popup-modal">
            <h3>Vente en cours...</h3>
            <div style="display: flex; justify-content: center; padding: 20px;">
                <div style="border: 4px solid #f3f3f3; border-top: 4px solid #f39c12; border-radius: 50%; width: 50px; height: 50px; animation: spin 1s linear infinite;"></div>
            </div>
            <p style="color: rgba(255, 255, 255, 0.7);">Traitement de la transaction</p>
        </div>
    </div>
    <style>
        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
}

<!-- Popup de succès -->
@if (showSuccessPopup)
{
    <div class="popup-backdrop">
        <div class="popup-modal success-modal">
            <div class="success-icon">✓</div>
            <h3>Vente réussie !</h3>
            <p class="success-item-name">@soldItemName</p>
            <p class="success-price">+@soldPrice</p>
            <p class="success-message">Votre portefeuille a été crédité</p>
            <button class="popup-close" @onclick="CloseSuccessPopup" style="background-color: #4CAF50; width: 100%; margin-top: 20px;">Fermer</button>
        </div>
    </div>
}

<!-- Popup d'erreur -->
@if (showErrorPopup)
{
    <div class="popup-backdrop">
        <div class="popup-modal error-modal">
            <div class="error-icon">✕</div>
            <h3>Erreur</h3>
            <p class="error-message-text">Une erreur est survenue lors de la vente. Veuillez réessayer.</p>
            <button class="popup-close" @onclick="CloseErrorPopup" style="background-color: #f44336; width: 100%; margin-top: 20px;">Fermer</button>
        </div>
    </div>
}

<div class="page-viewermodel">
    <div class="model-viewer">
        @if (ViewModel.IsLoading)
        {
            <div class="loading">                
                <span class="loader"></span>                
                <div class="progress">
                    <div class="progress-bar" role="progressbar" style="width: @(ViewModel.LoadingProgress)%;" aria-valuenow="@ViewModel.LoadingProgress" aria-valuemin="0" aria-valuemax="100">
                        <p>@ViewModel.LoadingProgress%</p>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(ViewModel.LoadingMessage))
                {
                    <p class="">@ViewModel.LoadingMessage</p>
                }
            </div>
        }
        <Viewer @ref="View3D1" Scene="ViewModel.Scene" />
        <div class="viewer-info">
            <i class="i-svg-icon">
                <svg fill="#000000" viewBox="-1 0 19 19" xmlns="http://www.w3.org/2000/svg" class="cf-icon-svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <path d="M16.417 9.583A7.917 7.917 0 1 1 8.5 1.666a7.917 7.917 0 0 1 7.917 7.917zM9.64 5.78a1.136 1.136 0 1 0-1.136 1.135A1.136 1.136 0 0 0 9.64 5.781zm-.344 2.884a.792.792 0 1 0-1.583 0v5.203a.792.792 0 0 0 1.583 0z"></path>
                    </g>
                </svg>
            </i>
            <div class="info-none">
                Utilisez la souris pour faire pivoter (clique droit), zoomer et déplacer (clique gauche) l'objet dans le Viewer.
            </div>
        </div>
    </div>

    @if (ViewModel.ItemDetails != null)
    {
        <div class="item-details">
            <div class="detail-header">
                <p class="item-name">@ViewModel.ItemDetails.ItemName | @ViewModel.ItemDetails.SkinName | @ViewModel.ItemDetails.WearTypeName</p>
                <span class="rarity-badge"  style="background-color: @ViewModel.ItemDetails.RarityColor">@ViewModel.ItemDetails.RarityName</span>
            </div>
            
            <div class="container-resume">
                <div class="resume-header">
                    <div class="resume-title">
                        <h2 class="title">Résumé de l'Objet</h2>
                    </div>
                </div>
                <div class="resume-body">
                    <div class="resume-grid">
                        <div class="resume-row">
                            <div class="">Type</div>
                            <div class="">@ViewModel.ItemDetails.ItemTypeName</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Arme</div>
                            <div class="">@ViewModel.ItemDetails.ItemName</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Float</div>
                            <div class="">@ViewModel.ItemDetails.Float</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Date Acquisition</div>
                            <div class="">@ViewModel.ItemDetails.AcquiredOn.ToString("dd/MM/yyyy HH'h'mm")</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Prix</div>
                            <div class="">@(ViewModel.ItemDetails.CurrentPrice?.ToString() ?? "N/A") €</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex">
                <p>Ajouter aux favoris :</p>
                <button class="btn-favorite @(ViewModel.ItemDetails.IsFavorite ? "is-favorite" : "")" 
                        @onclick="async () => await ViewModel.ToggleFavoriteAsync(ViewModel.ItemDetails.InventoryItemId)"
                        @onclick:stopPropagation="true">
                    @(ViewModel.ItemDetails.IsFavorite ? "★" : "☆")
                </button>
            </div>

            <div class="sell-section">
                <button class="btn-sell" @onclick="HandleSellClick">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    Vendre pour @(ViewModel.ItemDetails.CurrentPrice ?? 0) €
                </button>
            </div>
        </div>
    }
    else if (!ViewModel.IsLoading && ViewModel.ItemDetails == null)
    {
        <div class="item-details">
            <p class="error-message">Impossible de charger les détails de l'item.</p>
        </div>
    }
</div>

<div class="price-history">
    <h2 class="price-history-title">Historique des Prix (30 derniers jours)</h2>
    <RadzenChart>
        <RadzenLineSeries Smooth="true"
                          Data="@ViewModel.PriceHistory"
                          CategoryProperty="PriceDate"
                          ValueProperty="PriceValue"
                          Title="Évolution du Prix"
                          Stroke="orange"
                          StrokeWidth="4"
                          LineType="LineType.Solid">
            <ChildContent>
                <RadzenMarkers MarkerType="MarkerType.Circle" Fill="orange" Stroke="orange" Size="6" StrokeWidth="2" />
            </ChildContent>
            <TooltipTemplate Context="data">
                <div style="padding: 8px;">
                    <strong>Date:</strong> @(((PriceHistoryDTO)data).PriceDate.ToString("dd/MM/yyyy"))<br/>
                    <strong>Prix:</strong> @(((PriceHistoryDTO)data).PriceValue.ToString("C2"))
                </div>
            </TooltipTemplate>
        </RadzenLineSeries>
        <RadzenCategoryAxis Padding="20" FormatString="{0:dd/MM}" />
        <RadzenValueAxis Formatter="@FormatPrice">
            <RadzenGridLines Visible="true" />
        </RadzenValueAxis>
        <RadzenLegend Position="LegendPosition.Top" />
    </RadzenChart>
</div>

@if (!isAuthenticated && ViewModel.NeedAuth)
{
    <AuthOverlay />
}

<script src="js/cacheHelper.js"></script>

@code {
    [Parameter]
    public required int InventoryItemId { get; set; }

    private Viewer View3D1 = null!;
    private bool isAuthenticated = false;

    private bool isSellingItem = false;
    private bool showSuccessPopup = false;
    private bool showErrorPopup = false;
    private bool showConfirmationPopup = false;
    private bool isSecondConfirmation = false;
    private string soldItemName = "";
    private string soldPrice = "";
    private string confirmationItemName = "";
    private string confirmationPrice = "";

    public void Dispose()
    {
        if (!isAuthenticated)
        {
            ViewModel.NeedAuth = false;
        }
        
        if (View3D1 != null)
        {
            View3D1.ObjectLoaded -= OnObjectLoaded;
            View3D1.JsModuleLoaded -= OnJsModuleLoaded;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        
        if (!isAuthenticated)
        {
            ViewModel.NeedAuth = true;
            return;
        }
        
        ViewModel.InitializeLights();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
        await base.OnInitializedAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            View3D1.ObjectLoaded += OnObjectLoaded;
            View3D1.JsModuleLoaded += OnJsModuleLoaded;
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task OnJsModuleLoaded()
    {
        await ViewModel.LoadModelAsync(InventoryItemId, View3D1);
        await ViewModel.DrawPriceHistoryGraph();
        StateHasChanged();
    }
    
    private async Task OnObjectLoaded(HomagGroup.Blazor3D.Events.Object3DArgs e)
    {
        await ViewModel.OnObjectLoaded(e);
        StateHasChanged();
    }

    string FormatPrice(object value)
    {
        if (value is decimal decimalValue)
        {
            return decimalValue.ToString("C2");
        }
        return value?.ToString() ?? "";
    }

    private void HandleSellClick()
    {
        if (ViewModel.ItemDetails == null) return;

        confirmationItemName = $"{ViewModel.ItemDetails.ItemName} | {ViewModel.ItemDetails.SkinName}";
        confirmationPrice = (ViewModel.ItemDetails.CurrentPrice ?? 0) + " €";
        isSecondConfirmation = false;
        showConfirmationPopup = true;
    }

    private async void ConfirmSell()
    {
        if (ViewModel.ItemDetails == null) return;

        if (!isSecondConfirmation && ViewModel.ItemDetails.IsFavorite)
        {
            isSecondConfirmation = true;
            StateHasChanged();
            return;
        }

        showConfirmationPopup = false;
        
        isSellingItem = true;
        StateHasChanged();

        var success = await ViewModel.SellItemAsync(ViewModel.ItemDetails.InventoryItemId);

        isSellingItem = false;

        if (success)
        {
            soldItemName = confirmationItemName;
            soldPrice = confirmationPrice;
            showSuccessPopup = true;
        }
        else
        {
            showErrorPopup = true;
        }
        
        StateHasChanged();
    }

    private void CancelSell()
    {
        showConfirmationPopup = false;
        isSecondConfirmation = false;
        StateHasChanged();
    }

    private async void CloseSuccessPopup()
    {
        showSuccessPopup = false;
        
        // Recharger les données de l'utilisateur pour mettre à jour le portefeuille
        await AuthService.LoadCurrentUserAsync();
        
        // Rediriger vers l'inventaire
        NavigationManager.NavigateTo("/inventory");
    }

    private void CloseErrorPopup()
    {
        showErrorPopup = false;
        StateHasChanged();
    }
}