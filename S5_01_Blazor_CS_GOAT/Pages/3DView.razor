@page "/viewModel/{InventoryItemId:int}"
@using HomagGroup.Blazor3D.Viewers
@using S5_01_Blazor_CS_GOAT.ViewModels
@using Radzen
@using Radzen.Blazor
@using Shared.DTO
@implements IDisposable
@inject ThreeDViewViewModel ViewModel

<div class="page-viewermodel">
    <div class="model-viewer">
        @if (ViewModel.IsLoading)
        {
            <div class="loading">                
                <span class="loader"></span>                
                <div class="progress">
                    <div class="progress-bar" role="progressbar" style="width: @(ViewModel.LoadingProgress)%;" aria-valuenow="@ViewModel.LoadingProgress" aria-valuemin="0" aria-valuemax="100">
                        <p>@ViewModel.LoadingProgress%</p>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(ViewModel.LoadingMessage))
                {
                    <p class="">@ViewModel.LoadingMessage</p>
                }
            </div>
        }
        <Viewer @ref="View3D1" Scene="ViewModel.Scene" />
        <div class="viewer-info">
            <i class="i-svg-icon">
                <svg fill="#000000" viewBox="-1 0 19 19" xmlns="http://www.w3.org/2000/svg" class="cf-icon-svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <path d="M16.417 9.583A7.917 7.917 0 1 1 8.5 1.666a7.917 7.917 0 0 1 7.917 7.917zM9.64 5.78a1.136 1.136 0 1 0-1.136 1.135A1.136 1.136 0 0 0 9.64 5.781zm-.344 2.884a.792.792 0 1 0-1.583 0v5.203a.792.792 0 0 0 1.583 0z"></path>
                    </g>
                </svg>
            </i>
            <div class="info-none">
                Utilisez la souris pour faire pivoter (clique droit), zoomer et déplacer (clique gauche) l'objet dans le Viewer.
            </div>
        </div>
    </div>

    @if (ViewModel.ItemDetails != null)
    {
        <div class="item-details">
            <div class="detail-header">
                <p class="item-name">@ViewModel.ItemDetails.ItemName | @ViewModel.ItemDetails.SkinName | @ViewModel.ItemDetails.WearTypeName</p>
                <span class="rarity-badge"  style="background-color: @ViewModel.ItemDetails.RarityColor">@ViewModel.ItemDetails.RarityName</span>
            </div>
            
            <div class="container-resume">
                <div class="resume-header">
                    <div class="resume-title">
                        <h2 class="title">Résumé de l'Objet</h2>
                    </div>
                </div>
                <div class="resume-body">
                    <div class="resume-grid">
                        <div class="resume-row">
                            <div class="">Type</div>
                            <div class="">@ViewModel.ItemDetails.ItemTypeName</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Arme</div>
                            <div class="">@ViewModel.ItemDetails.ItemName</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Float</div>
                            <div class="">@ViewModel.ItemDetails.Float</div>
                        </div>
                        <div class="resume-row">
                            <div class="">Date Acquisition</div>
                            <div class="">@ViewModel.ItemDetails.AcquiredOn.ToString("dd/MM/yyyy HH'h'mm")</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex">
                <p>Ajouter aux favoris :</p>
                <button class="btn-favorite @(ViewModel.ItemDetails.IsFavorite ? "is-favorite" : "")" 
                        @onclick="async () => await ViewModel.ToggleFavoriteAsync(ViewModel.ItemDetails.InventoryItemId)"
                        @onclick:stopPropagation="true">
                    @(ViewModel.ItemDetails.IsFavorite ? "★" : "☆")
                </button>
            </div>
        </div>
    }
    else if (!ViewModel.IsLoading && ViewModel.ItemDetails == null)
    {
        <div class="item-details">
            <p class="error-message">Impossible de charger les détails de l'item.</p>
        </div>
    }
</div>

<div class="price-history">
    <h2 class="price-history-title">Historique des Prix (30 derniers jours)</h2>
    <RadzenChart>
        <RadzenLineSeries Smooth="true"
                          Data="@ViewModel.PriceHistory"
                          CategoryProperty="PriceDate"
                          ValueProperty="PriceValue"
                          Title="Évolution du Prix"
                          Stroke="orange"
                          StrokeWidth="4"
                          LineType="LineType.Solid">
            <ChildContent>
                <RadzenMarkers MarkerType="MarkerType.Circle" Fill="orange" Stroke="orange" Size="6" StrokeWidth="2" />
            </ChildContent>
            <TooltipTemplate Context="data">
                <div style="padding: 8px;">
                    <strong>Date:</strong> @(((PriceHistoryDTO)data).PriceDate.ToString("dd/MM/yyyy"))<br/>
                    <strong>Prix:</strong> @(((PriceHistoryDTO)data).PriceValue.ToString("C2"))
                </div>
            </TooltipTemplate>
        </RadzenLineSeries>
        <RadzenCategoryAxis Padding="20" FormatString="{0:dd/MM}" />
        <RadzenValueAxis Formatter="@FormatPrice">
            <RadzenGridLines Visible="true" />
        </RadzenValueAxis>
        <RadzenLegend Position="LegendPosition.Top" />
    </RadzenChart>
</div>

<script src="js/cacheHelper.js"></script>

@code {
    [Parameter]
    public required int InventoryItemId { get; set; }

    private Viewer View3D1 = null!;

    public void Dispose()
    {
        View3D1.ObjectLoaded -= OnObjectLoaded;
        View3D1.JsModuleLoaded -= OnJsModuleLoaded;
    }

    protected override Task OnInitializedAsync()
    {
        ViewModel.InitializeLights();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
        return base.OnInitializedAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            View3D1.ObjectLoaded += OnObjectLoaded;
            View3D1.JsModuleLoaded += OnJsModuleLoaded;
        }

        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task OnJsModuleLoaded()
    {
        await ViewModel.LoadModelAsync(InventoryItemId, View3D1);
        await ViewModel.DrawPriceHistoryGraph();
        StateHasChanged();
    }
    
    private async Task OnObjectLoaded(HomagGroup.Blazor3D.Events.Object3DArgs e)
    {
        ViewModel.OnObjectLoaded(e);
        StateHasChanged();
    }

    string FormatPrice(object value)
    {
        if (value is decimal decimalValue)
        {
            return decimalValue.ToString("C2");
        }
        return value?.ToString() ?? "";
    }
}