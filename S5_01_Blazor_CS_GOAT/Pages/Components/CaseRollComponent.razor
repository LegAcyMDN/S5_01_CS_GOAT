@using S5_01_Blazor_CS_GOAT.Models
@using S5_01_Blazor_CS_GOAT.ViewModels
@using Shared.DTO
@inject CaseRollComponentViewModel ViewModel

<div class="raffle-roller">
    <div class="raffle-roller-holder">
        <div class="raffle-roller-container raffle-container-@ComponentId" style="margin-left: 0px; display: flex; flex-direction: row">
            @if (ViewModel.ListSkins.Count == 0)
            {
                <!-- Empty state -->
            }
            else
            {
                @foreach (SkinDTO skin in ViewModel.ListSkins)
                {
                    <div class="skin-in-case">
                        <WeaponDisplayComponent WeaponSkin=@skin ImageLink=@($"https://screenshots.cs.money/csmoney2/{skin.AnyUuid}_icon.png")></WeaponDisplayComponent>
                    </div>
                }
            }
        </div>
    </div>
</div>
@code {
    [Parameter]
    public required List<SkinDTO> listSkins { get; set; }
    
    [Parameter]
    public EventCallback OnAnimationComplete { get; set; }

    private bool _hasRendered = false;
    private string ComponentId = Guid.NewGuid().ToString();

    protected override void OnInitialized()
    {
        ViewModel.ListSkins = listSkins;
        ViewModel.AnimationCompleted += OnAnimationCompleted;
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRendered)
        {
            _hasRendered = true;
            await ViewModel.OpenCaseAsyncWithId(ComponentId);
        }
    }

    private async void OnAnimationCompleted(object? sender, string componentId)
    {
        Console.WriteLine($"Component {componentId} animation finished!");
        await OnAnimationComplete.InvokeAsync();
    }

    protected override void OnParametersSet()
    {
        ViewModel.ListSkins = listSkins;
    }

    public void Dispose()
    {
        ViewModel.AnimationCompleted -= OnAnimationCompleted;
    }
}