@using S5_01_Blazor_CS_GOAT.Models
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject CaseRollComponentViewModel ViewModel

<div class="raffle-roller">
    <div class="raffle-roller-holder">
        <div class="raffle-roller-container" style="margin-left: 0px; display: flex; flex-direction: row">
            @if (ViewModel.ListSkins.Count == 0)
            {
                <!-- Empty state -->
            }
            else
            {
                @foreach (Skin skin in ViewModel.ListSkinsInCaseRoll)
                {
                    <div class="skin-in-case">
                        <WeaponDisplayComponent WeaponSkin=@skin ImageLink=@($"https://screenshots.cs.money/csmoney2/{skin.AnyUuid}_icon.png")></WeaponDisplayComponent>
                    </div>
                }
            }
        </div>
    </div>
</div>
<div style="text-align: center;">
    <span style="font-size: 25px;">You winning is 
        <span style="color: green;" id="rolled">rolling</span>
    </span>
    <br>
    <button @onclick="async () => await ViewModel.OpenCaseAsync()" style="color: black">go</button>
</div>

@code {
    [Parameter]
    public required List<Skin> listSkins { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.ListSkins = listSkins;
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        ViewModel.ListSkins = listSkins;
    }
}