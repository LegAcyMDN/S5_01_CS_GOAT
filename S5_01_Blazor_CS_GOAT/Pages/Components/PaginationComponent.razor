@* Composant de pagination pour les tableaux d'administration *@

<div class="pagination-container">
    <div class="pagination-info">
        <span>Affichage de @StartItem à @EndItem sur @FilteredCount résultats</span>
        @if (FilteredCount != TotalCount)
        {
            <span class="filtered-info">(sur @TotalCount total)</span>
        }
    </div>
    
    <div class="pagination-controls">
        <button class="pagination-btn" 
                @onclick="() => OnPageChanged(1)" 
                disabled="@(CurrentPage == 1)"
                title="Première page">
            ⏪
        </button>
        
        <button class="pagination-btn" 
                @onclick="() => OnPageChanged(CurrentPage - 1)" 
                disabled="@(CurrentPage == 1)"
                title="Page précédente">
            ◀️
        </button>
        
        <div class="pagination-pages">
            @foreach (var pageNum in GetPageNumbers())
            {
                <button class="pagination-btn @(pageNum == CurrentPage ? "active" : "")" 
                        @onclick="() => OnPageChanged(pageNum)"
                        title="Page @pageNum">
                    @pageNum
                </button>
            }
        </div>
        
        <button class="pagination-btn" 
                @onclick="() => OnPageChanged(CurrentPage + 1)" 
                disabled="@(CurrentPage == TotalPages)"
                title="Page suivante">
            ▶️
        </button>
        
        <button class="pagination-btn" 
                @onclick="() => OnPageChanged(TotalPages)" 
                disabled="@(CurrentPage == TotalPages)"
                title="Dernière page">
            ⏩
        </button>
    </div>
    
    <div class="page-size-selector">
        <label>Par page:</label>
        <select @onchange="OnPageSizeChanged" value="@PageSize">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>
    </div>
</div>

@code {
    [Parameter]
    public int CurrentPage { get; set; } = 1;
    
    [Parameter]
    public int TotalPages { get; set; }
    
    [Parameter]
    public int PageSize { get; set; } = 25;
    
    [Parameter]
    public int TotalCount { get; set; }
    
    [Parameter]
    public int FilteredCount { get; set; }
    
    [Parameter]
    public EventCallback<int> OnPageChange { get; set; }
    
    [Parameter]
    public EventCallback<int> OnPageSizeChange { get; set; }
    
    private int StartItem => FilteredCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int EndItem => Math.Min(CurrentPage * PageSize, FilteredCount);
    
    private async Task OnPageChanged(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            await OnPageChange.InvokeAsync(page);
        }
    }
    
    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            await OnPageSizeChange.InvokeAsync(newSize);
        }
    }
    
    private IEnumerable<int> GetPageNumbers()
    {
        const int maxButtons = 5;
        int start = Math.Max(1, CurrentPage - maxButtons / 2);
        int end = Math.Min(TotalPages, start + maxButtons - 1);
        
        if (end - start < maxButtons - 1)
        {
            start = Math.Max(1, end - maxButtons + 1);
        }
        
        return Enumerable.Range(start, end - start + 1);
    }
}
