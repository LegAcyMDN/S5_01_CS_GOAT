@using S5_01_Blazor_CS_GOAT.ViewModels
@using S5_01_Blazor_CS_GOAT.Pages.Components
@using Shared.DTO
@inject IJSRuntime JSRuntime

<div class="promocodes-section">
    <div class="section-header">
        <h2>Gestion des Codes Promo</h2>
        <div class="header-actions">
            <button class="btn btn-primary" @onclick="() => PromoCodeViewModel.OpenCreateModal()">
                ➕ Nouveau Code Promo
            </button>
        </div>
    </div>

    <!-- Nouveau composant de filtres -->
    <PromoCodesTableFilter @ref="filterComponent"
        OnSearchTermChanged="@HandleSearchTermChanged"
        OnApplyFiltersAndSort="@HandleApplyFiltersAndSort"
        OnReset="@HandleReset" />

    @if (PromoCodeViewModel.IsLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Chargement des codes promos...</p>
        </div>
    }
    else
    {
        <!-- Tableau des codes promos -->
        <div class="promocodes-table-container">
            <table class="promocodes-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Utilisations</th>
                        <th>% Réduction</th>
                        <th>Montant</th>
                        <th>Début</th>
                        <th>Expiration</th>
                        <th>Type</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (filteredPromoCodes != null && filteredPromoCodes.Any())
                    {
                        @foreach (var promo in filteredPromoCodes)
                        {
                            var status = PromoCodeViewModel.GetPromoStatus(promo);
                            var nextRefresh = PromoCodeViewModel.GetNextRefresh(promo);
                            var willBeDeleted = PromoCodeViewModel.WillBeDeleted(promo);

                            <tr class="@status.CssClass">
                                <td>@promo.PromoCodeId</td>
                                <td>
                                    <strong>@promo.Code</strong>
                                    @if (willBeDeleted)
                                    {
                                        <span class="warning-badge" title="Ce code sera automatiquement supprimé">⚠️</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.RemainingUses.HasValue)
                                    {
                                        <span class="@(promo.RemainingUses == 0 ? "text-danger" : "")">
                                            @promo.RemainingUses
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">♾️ Illimité</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.DiscountPercentage.HasValue)
                                    {
                                        <span class="discount-badge">@promo.DiscountPercentage%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.DiscountAmount.HasValue)
                                    {
                                        <span class="discount-badge">@($"{promo.DiscountAmount:F2}€")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@promo.ValidityStart.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (promo.ExpiryDate.HasValue)
                                    {
                                        <span>@promo.ExpiryDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (promo.RefreshDelay.HasValue)
                                        {
                                            <br />
                                            <small class="text-info" title="Délai de rafraîchissement">
                                                🔄 +@FormatTimeSpan(promo.RefreshDelay.Value)
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-success">Permanent</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.UserId.HasValue)
                                    {
                                        <span class="badge badge-user">
                                            👤 @(string.IsNullOrEmpty(promo.UserLogin) ? $"User #{promo.UserId}" : promo.UserLogin)
                                        </span>
                                    }
                                    else if (promo.CaseId.HasValue)
                                    {
                                        <span class="badge badge-case">
                                            📦 @(string.IsNullOrEmpty(promo.CaseName) ? $"Case #{promo.CaseId}" : promo.CaseName)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-global">🌍 Global</span>
                                    }
                                </td>
                                <td>
                                    <div class="status-container" title="@status.Description">
                                        <span class="status-badge @status.CssClass">@status.Status</span>
                                        @if (nextRefresh.HasValue && promo.RefreshDelay.HasValue)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                Prochain: @nextRefresh.Value.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-action btn-edit" 
                                                @onclick="() => PromoCodeViewModel.OpenEditModal(promo)"
                                                title="Modifier">
                                            ✏️
                                        </button>
                                        <button class="btn-action btn-delete" 
                                                @onclick="async () => await ConfirmDeletePromoCode(promo.PromoCodeId, promo.Code)"
                                                title="Supprimer">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="no-data">Aucun code promo trouvé</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <PaginationComponent 
            CurrentPage="@PromoCodeViewModel.CurrentPage"
            TotalPages="@PromoCodeViewModel.TotalPages"
            PageSize="@PromoCodeViewModel.PageSize"
            TotalCount="@PromoCodeViewModel.TotalCount"
            FilteredCount="@PromoCodeViewModel.FilteredCount"
            OnPageChange="@PromoCodeViewModel.ChangePageAsync"
            OnPageSizeChange="@PromoCodeViewModel.ChangePageSizeAsync" />
    }
</div>

@code {
    [Parameter]
    public PromoCodeViewModel PromoCodeViewModel { get; set; } = default!;

    private PromoCodesTableFilter? filterComponent;
    private List<PromoCodeDTO>? filteredPromoCodes;

    protected override void OnParametersSet()
    {
        ApplyClientSideFilters();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Appliquer les filtres après le premier rendu quand filterComponent est initialisé
            ApplyClientSideFilters();
            StateHasChanged();
        }
    }

    private void ApplyClientSideFilters()
    {
        if (PromoCodeViewModel.AllPromoCodes != null && filterComponent != null)
        {
            filteredPromoCodes = filterComponent.FilterPromoCodesClientSide(PromoCodeViewModel.AllPromoCodes);
        }
        else
        {
            filteredPromoCodes = PromoCodeViewModel.AllPromoCodes;
        }
    }

    private async Task HandleSearchTermChanged(string searchTerm)
    {
        PromoCodeViewModel.SearchQuery = searchTerm;
        await PromoCodeViewModel.SearchAsync();
        // Forcer le rafraîchissement pour appliquer les filtres client
        await InvokeAsync(() =>
        {
            ApplyClientSideFilters();
            StateHasChanged();
        });
    }

    private async Task HandleApplyFiltersAndSort((string? sortKey, string sortType, Dictionary<string, List<string>> filters) args)
    {
        PromoCodeViewModel.SortKey = args.sortKey;
        PromoCodeViewModel.SortType = args.sortType;
        PromoCodeViewModel.Filters = args.filters;
        await PromoCodeViewModel.LoadPromoCodesAsync();
        // Forcer le rafraîchissement pour appliquer les filtres client
        await InvokeAsync(() =>
        {
            ApplyClientSideFilters();
            StateHasChanged();
        });
    }

    private async Task HandleReset()
    {
        await PromoCodeViewModel.ResetFiltersAsync();
        // Forcer le rafraîchissement pour appliquer les filtres client
        await InvokeAsync(() =>
        {
            ApplyClientSideFilters();
            StateHasChanged();
        });
    }

    private async Task ConfirmDeletePromoCode(int promoCodeId, string code)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer le code promo '{code}' ? Cette action est irréversible."))
        {
            await PromoCodeViewModel.DeletePromoCodeAsync(promoCodeId);
            ApplyClientSideFilters();
        }
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalDays >= 1)
        {
            return $"{(int)timeSpan.TotalDays}j";
        }
        else if (timeSpan.TotalHours >= 1)
        {
            return $"{(int)timeSpan.TotalHours}h";
        }
        else if (timeSpan.TotalMinutes >= 1)
        {
            return $"{(int)timeSpan.TotalMinutes}min";
        }
        else
        {
            return $"{(int)timeSpan.TotalSeconds}s";
        }
    }
}
