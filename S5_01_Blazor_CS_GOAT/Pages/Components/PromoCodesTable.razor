@using S5_01_Blazor_CS_GOAT.ViewModels
@using S5_01_Blazor_CS_GOAT.Pages.Components
@using Shared.DTO
@inject IJSRuntime JSRuntime

<div class="promocodes-section">
    <div class="section-header">
        <h2>Gestion des Codes Promo</h2>
        <div class="header-actions">
            <button class="btn btn-primary" @onclick="() => PromoCodeViewModel.OpenCreateModal()">
                ➕ Nouveau Code Promo
            </button>
        </div>
    </div>

    <!-- Composant de recherche et filtres -->
    <AdminSearchFilter 
        SearchPlaceholder="Rechercher un code..."
        SearchTerm="@PromoCodeViewModel.SearchQuery"
        SortKey="@PromoCodeViewModel.SortKey"
        SortType="@PromoCodeViewModel.SortType"
        SortableProperties="@promoCodeSortableProperties"
        HasFilters="true"
        ActiveFiltersCount="@GetActiveFiltersCount()"
        OnSearch="@(() => PromoCodeViewModel.SearchAsync())"
        OnApplySort="@(async (args) => await PromoCodeViewModel.ChangeSortAsync(args.sortKey, args.sortType))"
        OnReset="@(() => PromoCodeViewModel.ResetFiltersAsync())">
        <FilterContent>
            <div class="filter-group">
                <label>Type de code</label>
                <select @onchange="@(async (e) => await OnTypeFilterChanged(e.Value?.ToString()))">
                    <option value="">Tous</option>
                    <option value="global">Global</option>
                    <option value="user">Utilisateur spécifique</option>
                    <option value="case">Case spécifique</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Statut</label>
                <select @onchange="@(async (e) => await OnStatusFilterChanged(e.Value?.ToString()))">
                    <option value="">Tous</option>
                    <option value="active">Actif</option>
                    <option value="expired">Expiré</option>
                    <option value="pending">En attente</option>
                    <option value="depleted">Épuisé</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Utilisations</label>
                <select @onchange="@(async (e) => await OnUsesFilterChanged(e.Value?.ToString()))">
                    <option value="">Tous</option>
                    <option value="unlimited">Illimité</option>
                    <option value="limited">Limité</option>
                </select>
            </div>

            <div class="filter-group">
                <label>Type de réduction</label>
                <select @onchange="@(async (e) => await OnDiscountTypeFilterChanged(e.Value?.ToString()))">
                    <option value="">Tous</option>
                    <option value="percentage">Pourcentage</option>
                    <option value="amount">Montant fixe</option>
                    <option value="both">Les deux</option>
                </select>
            </div>
        </FilterContent>
    </AdminSearchFilter>

    @if (PromoCodeViewModel.IsLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Chargement des codes promos...</p>
        </div>
    }
    else
    {
        <!-- Tableau des codes promos -->
        <div class="promocodes-table-container">
            <table class="promocodes-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Code</th>
                        <th>Utilisations</th>
                        <th>% Réduction</th>
                        <th>Montant</th>
                        <th>Début</th>
                        <th>Expiration</th>
                        <th>Type</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (PromoCodeViewModel.AllPromoCodes != null && PromoCodeViewModel.AllPromoCodes.Any())
                    {
                        @foreach (var promo in PromoCodeViewModel.AllPromoCodes)
                        {
                            var status = PromoCodeViewModel.GetPromoStatus(promo);
                            var nextRefresh = PromoCodeViewModel.GetNextRefresh(promo);
                            var willBeDeleted = PromoCodeViewModel.WillBeDeleted(promo);

                            <tr class="@status.CssClass">
                                <td>@promo.PromoCodeId</td>
                                <td>
                                    <strong>@promo.Code</strong>
                                    @if (willBeDeleted)
                                    {
                                        <span class="warning-badge" title="Ce code sera automatiquement supprimé">⚠️</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.RemainingUses.HasValue)
                                    {
                                        <span class="@(promo.RemainingUses == 0 ? "text-danger" : "")">
                                            @promo.RemainingUses
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-success">♾️ Illimité</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.DiscountPercentage.HasValue)
                                    {
                                        <span class="discount-badge">@promo.DiscountPercentage%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.DiscountAmount.HasValue)
                                    {
                                        <span class="discount-badge">@($"{promo.DiscountAmount:F2}€")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@promo.ValidityStart.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (promo.ExpiryDate.HasValue)
                                    {
                                        <span>@promo.ExpiryDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                        @if (promo.RefreshDelay.HasValue)
                                        {
                                            <br />
                                            <small class="text-info" title="Délai de rafraîchissement">
                                                🔄 +@FormatTimeSpan(promo.RefreshDelay.Value)
                                            </small>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-success">Permanent</span>
                                    }
                                </td>
                                <td>
                                    @if (promo.UserId.HasValue)
                                    {
                                        <span class="badge badge-user">
                                            👤 @(string.IsNullOrEmpty(promo.UserLogin) ? $"User #{promo.UserId}" : promo.UserLogin)
                                        </span>
                                    }
                                    else if (promo.CaseId.HasValue)
                                    {
                                        <span class="badge badge-case">
                                            📦 @(string.IsNullOrEmpty(promo.CaseName) ? $"Case #{promo.CaseId}" : promo.CaseName)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-global">🌍 Global</span>
                                    }
                                </td>
                                <td>
                                    <div class="status-container" title="@status.Description">
                                        <span class="status-badge @status.CssClass">@status.Status</span>
                                        @if (nextRefresh.HasValue && promo.RefreshDelay.HasValue)
                                        {
                                            <br />
                                            <small class="text-muted">
                                                Prochain: @nextRefresh.Value.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <button class="btn-action btn-edit" 
                                                @onclick="() => PromoCodeViewModel.OpenEditModal(promo)"
                                                title="Modifier">
                                            ✏️
                                        </button>
                                        <button class="btn-action btn-delete" 
                                                @onclick="async () => await ConfirmDeletePromoCode(promo.PromoCodeId, promo.Code)"
                                                title="Supprimer">
                                            🗑️
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="no-data">Aucun code promo trouvé</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <PaginationComponent 
            CurrentPage="@PromoCodeViewModel.CurrentPage"
            TotalPages="@PromoCodeViewModel.TotalPages"
            PageSize="@PromoCodeViewModel.PageSize"
            TotalCount="@PromoCodeViewModel.TotalCount"
            FilteredCount="@PromoCodeViewModel.FilteredCount"
            OnPageChange="@PromoCodeViewModel.ChangePageAsync"
            OnPageSizeChange="@PromoCodeViewModel.ChangePageSizeAsync" />
    }
</div>

@code {
    [Parameter]
    public PromoCodeViewModel PromoCodeViewModel { get; set; } = default!;

    private Dictionary<string, string> promoCodeSortableProperties = new()
    {
        { "code", "Code" },
        { "validitystart", "Date de début" },
        { "expirydate", "Date d'expiration" },
        { "discountpercentage", "% Réduction" },
        { "discountamount", "Montant" },
        { "remaininguses", "Utilisations restantes" }
    };

    private int GetActiveFiltersCount()
    {
        return PromoCodeViewModel.Filters?.Count ?? 0;
    }

    private async Task OnTypeFilterChanged(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            await PromoCodeViewModel.RemoveFilterAsync("userid");
            await PromoCodeViewModel.RemoveFilterAsync("caseid");
        }
        else if (value == "global")
        {
            // Filtrer les codes sans userId ni caseId (à implémenter côté backend si nécessaire)
            await PromoCodeViewModel.RemoveFilterAsync("userid");
            await PromoCodeViewModel.RemoveFilterAsync("caseid");
        }
        else if (value == "user")
        {
            // Filtrer les codes avec userId (logique à adapter)
            await PromoCodeViewModel.AddFilterAsync("userid", new List<string> { "notnull" });
        }
        else if (value == "case")
        {
            // Filtrer les codes avec caseId (logique à adapter)
            await PromoCodeViewModel.AddFilterAsync("caseid", new List<string> { "notnull" });
        }
    }

    private async Task OnStatusFilterChanged(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            await PromoCodeViewModel.RemoveFilterAsync("status");
        }
        else
        {
            await PromoCodeViewModel.AddFilterAsync("status", new List<string> { value });
        }
    }

    private async Task OnUsesFilterChanged(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            await PromoCodeViewModel.RemoveFilterAsync("remaininguses");
        }
        else if (value == "unlimited")
        {
            await PromoCodeViewModel.AddFilterAsync("remaininguses", new List<string> { "null" });
        }
        else if (value == "limited")
        {
            await PromoCodeViewModel.AddFilterAsync("remaininguses", new List<string> { "notnull" });
        }
    }

    private async Task OnDiscountTypeFilterChanged(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            await PromoCodeViewModel.RemoveFilterAsync("discounttype");
        }
        else
        {
            await PromoCodeViewModel.AddFilterAsync("discounttype", new List<string> { value });
        }
    }

    private async Task ConfirmDeletePromoCode(int promoCodeId, string code)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer le code promo '{code}' ? Cette action est irréversible."))
        {
            await PromoCodeViewModel.DeletePromoCodeAsync(promoCodeId);
        }
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalDays >= 1)
        {
            return $"{(int)timeSpan.TotalDays}j";
        }
        else if (timeSpan.TotalHours >= 1)
        {
            return $"{(int)timeSpan.TotalHours}h";
        }
        else if (timeSpan.TotalMinutes >= 1)
        {
            return $"{(int)timeSpan.TotalMinutes}min";
        }
        else
        {
            return $"{(int)timeSpan.TotalSeconds}s";
        }
    }
}
