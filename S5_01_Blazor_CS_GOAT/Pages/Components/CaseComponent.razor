@using S5_01_Blazor_CS_GOAT.Models
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject CaseComponentViewModel ViewModel

<div class="case-format" @onclick="ViewModel.NavigateToCase">
    <img src="cases/@ViewModel.CaseObject?.CaseImage"/>
    <h3>@ViewModel.CaseObject?.CaseName | @ViewModel.CaseObject?.CasePrice€</h3>
</div>

@code {
    [Parameter]
    public required Case CaseObject { get; set; }

    protected override void OnParametersSet()
    {
        ViewModel.CaseObject = CaseObject;
    }
}