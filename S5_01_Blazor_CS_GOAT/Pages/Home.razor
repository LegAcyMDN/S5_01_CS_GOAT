@page "/"
@using S5_01_Blazor_CS_GOAT.Pages.Components
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject HomeViewModel ViewModel
@implements IDisposable

<PageTitle>CS:GOAT</PageTitle>

<SearchFilterComponent 
    SearchPlaceholder="Rechercher une caisse par nom..."
    ShowSearchBar="false"
    SearchTerm="@ViewModel.SearchTerm"
    SearchTermChanged="@((value) => ViewModel.SearchTerm = value)"
    SortKey="@ViewModel.SortKey"
    SortKeyChanged="@((value) => ViewModel.SortKey = value)"
    SortType="@ViewModel.SortType"
    SortTypeChanged="@((value) => ViewModel.SortType = value)"
    ShowOnlyFavorites="@ViewModel.ShowOnlyFavorites"
    ShowOnlyFavoritesChanged="@((value) => ViewModel.ShowOnlyFavorites = value)"
    ShowFavoritesFilter="true"
    SortableProperties="@ViewModel.SortableProperties" />

<div class="display-cases">
    @if (ViewModel.IsLoading)
    {
        <p><em>Loading...</em></p>    
    }
    else
    {
        @if (ViewModel.HasNoFilteredCases)
        {
            <p><em>Aucune caisse trouvée pour votre recherche.</em></p>
        }
        else
        {
            @foreach (var singleCase in ViewModel.Cases)
            {
                <CaseComponent CaseObject="@singleCase"></CaseComponent>
            }
        }
    }
</div>

@if (!ViewModel.IsLoading && ViewModel.TotalCount > 0)
{
    <PaginationComponent 
        CurrentPage="@ViewModel.CurrentPage"
        TotalPages="@ViewModel.TotalPages"
        PageSize="@ViewModel.PageSize"
        TotalCount="@ViewModel.TotalCount"
        FilteredCount="@ViewModel.FilteredCount"
        OnPageChange="@((page) => ViewModel.CurrentPage = page)"
        OnPageSizeChange="@((pageSize) => ViewModel.PageSize = pageSize)" />
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }

    public void Dispose()
    {
        ViewModel.Dispose();
    }
}
