@page "/stats"
@using S5_01_Blazor_CS_GOAT.ViewModels
@using S5_01_Blazor_CS_GOAT.Layout
@using S5_01_Blazor_CS_GOAT.Pages.Components
@inject FairRandomViewModel ViewModel

<PageTitle>CS:GOAT - Provably Fair</PageTitle>

<div class="fairrandom-page">
    <h1>Provably Fair - Historique des tirages</h1>
    
    @if (ViewModel.IsLoading)
    {
        <p class="loading-message">Chargement de l'historique...</p>
    }
    else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
    {
        <div class="error-message">
            <p>@ViewModel.ErrorMessage</p>
        </div>
    }
    else if (ViewModel.TotalCount == 0)
    {
        <div class="empty-message">
            <p>Aucun historique de tirage disponible. Ouvrez des caisses pour générer votre historique!</p>
        </div>
    }
    else
    {
        <div class="fairrandom-info">
            <p>Vérifiez l'équité de tous vos tirages. Chaque tirage utilise un système provably fair pour garantir des résultats aléatoires et transparents.</p>
        </div>
        
        <SearchFilterComponent 
            SearchPlaceholder="Rechercher par hash serveur..."
            ShowSearchBar="true"
            SearchTerm="@ViewModel.SearchTerm"
            SearchTermChanged="@(async (value) => await ViewModel.OnSearchTermChangedAsync(value))"
            SortKey="@ViewModel.SortKey"
            SortKeyChanged="@(async (value) => await ViewModel.OnSortKeyChangedAsync(value))"
            SortType="@ViewModel.SortType"
            SortTypeChanged="@(async (value) => await ViewModel.OnSortTypeChangedAsync(value))"
            ShowFavoritesFilter="false"
            SortableProperties="@ViewModel.SortableProperties" />
        
        <div class="fairrandom-table">
            <table>
                <thead>
                    <tr>
                        <th>Graine Serveur</th>
                        <th>Hash Serveur</th>
                        <th>Graine Utilisateur</th>
                        <th>Nonce Utilisateur</th>
                        <th>Hash Combiné</th>
                        <th>Fraction 1</th>
                        <th>Fraction 2</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ViewModel.FairRandomHistory.Count == 0)
                    {
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 2rem;">
                                Aucun résultat trouvé pour votre recherche.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var fairRandom in ViewModel.FairRandomHistory)
                        {
                            <tr>
                                <td title="@fairRandom.ServerSeed">@fairRandom.ServerSeed</td>
                                <td title="@fairRandom.ServerHash">@fairRandom.ServerHash</td>
                                <td title="@fairRandom.UserSeed">@fairRandom.UserSeed</td>
                                <td>@fairRandom.UserNonce</td>
                                <td title="@fairRandom.CombinedHash">@fairRandom.CombinedHash</td>
                                <td>@fairRandom.Fraction1.ToString("F6")</td>
                                <td>@fairRandom.Fraction2.ToString("F6")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        
        <PaginationComponent 
            CurrentPage="@ViewModel.CurrentPage"
            TotalPages="@ViewModel.TotalPages"
            PageSize="@ViewModel.PageSize"
            TotalCount="@ViewModel.TotalCount"
            FilteredCount="@ViewModel.FilteredCount"
            OnPageChange="@(async (page) => await ViewModel.OnPageChangedAsync(page))"
            OnPageSizeChange="@(async (size) => await ViewModel.OnPageSizeChangedAsync(size))" />
    }
    
    <AuthOverlay />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }

    private string TruncateHash(string hash)
    {
        if (string.IsNullOrEmpty(hash))
            return "-";
        
        if (hash.Length <= 16)
            return hash;
        
        return $"{hash.Substring(0, 8)}...{hash.Substring(hash.Length - 8)}";
    }
}
