@page "/inventory"
@using S5_01_Blazor_CS_GOAT.Layout
@using S5_01_Blazor_CS_GOAT.Models
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject InventoryViewModel ViewModel

<div class="inventory-page">
    <h1>Mon Inventaire</h1>
    
    @if (ViewModel.IsLoading)
    {
        <div class="loading">
            <p>Chargement de votre inventaire...</p>
        </div>
    }
    else if (!ViewModel.IsAuthenticated)
    {
        <div class="inventory-content">
            <p>Vous devez être connecté pour voir votre inventaire.</p>
        </div>
    }
    else if (ViewModel.IsInventoryEmpty)
    {
        <div class="inventory-content">
            <p>Votre inventaire est vide. Commencez à ouvrir des caisses pour obtenir des skins !</p>
        </div>
    }
    else
    {
        <div class="inventory-content">
            <div class="inventory-stats">
                <p>Total d'items : @ViewModel.TotalItemsCount</p>
            </div>
            
            <div class="inventory-grid">
                @foreach (var item in ViewModel.GetSortedInventoryItems())
                {
                    <div class="inventory-item" style="border-color: @item.RarityColor" @onclick="() => ViewModel.NavigateToItemDetail(item.InventoryItemId)">
                        <div class="item-image">
                            <img src="@ViewModel.GetItemImageUrl(item)" alt="@item.SkinName" />
                        </div>
                        
                        <button class="btn-favorite @(item.IsFavorite ? "is-favorite" : "")" 
                                @onclick="async () => await ViewModel.ToggleFavoriteAsync(item.InventoryItemId)"
                                @onclick:stopPropagation="true">
                            @(item.IsFavorite ? "★" : "☆")
                        </button>
                    </div>
                }
            </div>
        </div>
    }
    
    <AuthOverlay />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }
}
