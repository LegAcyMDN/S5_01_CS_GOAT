@page "/wallet"
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject WalletViewModel ViewModel

<h3>Portefeuille</h3>

@if (!ViewModel.IsLoading && ViewModel.CurrentUser != null)
{
    <h1>@ViewModel.CurrentUser.Wallet €</h1>

    <h3>Ajouter des fonds</h3>
    <div class="add-funds">
        <button class="add-funds-button" @onclick="() => ViewModel.AddFunds(10)">+10€</button>
        <button class="add-funds-button" @onclick="() => ViewModel.AddFunds(25)">+25€</button>
        <button class="add-funds-button" @onclick="() => ViewModel.AddFunds(50)">+50€</button>
        <button class="add-funds-button" @onclick="() => ViewModel.AddFunds(100)">+100€</button>
        <button class="add-funds-button" @onclick="() => ViewModel.AddFunds(1000)">+1000€</button>
        <button class="add-funds-button" @onclick="() => ViewModel.AddFunds(10000)">+10000€</button>
    </div>
    <h3>Retirer des fonds</h3>
    <div class="withdraw-funds">
        <button class="withdraw-funds-button" @onclick="() => ViewModel.WithdrawFunds(10)">-10€</button>
        <button class="withdraw-funds-button" @onclick="() => ViewModel.WithdrawFunds(25)">-25€</button>
        <button class="withdraw-funds-button" @onclick="() => ViewModel.WithdrawFunds(50)">-50€</button>
        <button class="withdraw-funds-button" @onclick="() => ViewModel.WithdrawFunds(100)">-100€</button>
    </div>

    <br/>
    <h2>Historique des paiements</h2>
    @if (ViewModel.TransactionsList != null)
    {
        @foreach (var transaction in ViewModel.TransactionsList)
        {
            <div>
                <p>Méthode de paiement : @transaction.PaymentMethod</p>
                <p>Montant de la transaction : @transaction.WalletValue €</p>
                <p>Date de la transaction : @transaction.TransactionDate</p>
            </div>
        }
    }
    else
    {
        <div>Chargement...</div>
    }
}
else
{
    <h1>CHARGEMENT</h1>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }

}