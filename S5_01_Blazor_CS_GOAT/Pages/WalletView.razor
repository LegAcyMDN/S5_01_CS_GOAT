@page "/wallet"
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject WalletViewModel ViewModel

<h3>Portefeuille</h3>

@if (!ViewModel.IsLoading && ViewModel.CurrentUser != null)
{
    <h1>@ViewModel.CurrentUser.Wallet €</h1>

    <h3>Ajouter des fonds</h3>
    <div class="add-funds">
        <button @onclick="() => ViewModel.AddFunds(10)">+10€</button>
        <button @onclick="() => ViewModel.AddFunds(25)">+25€</button>
        <button @onclick="() => ViewModel.AddFunds(50)">+50€</button>
        <button @onclick="() => ViewModel.AddFunds(100)">+100€</button>
    </div>
    <h3>Retirer des fonds</h3>
    <div class="withdraw-funds">
        <button @onclick="() => ViewModel.WithdrawFunds(10)">-10€</button>
        <button @onclick="() => ViewModel.WithdrawFunds(25)">-25€</button>
        <button @onclick="() => ViewModel.WithdrawFunds(50)">-50€</button>
        <button @onclick="() => ViewModel.WithdrawFunds(100)">-100€</button>
    </div>

    <br/>
    <h2>Historique des paiements</h2>
    @if (ViewModel.TransactionsList != null)
    {
        @foreach (var transaction in ViewModel.TransactionsList)
        {
            <div>
                <p>Méthode de paiement : @transaction.PaymentMethod</p>
                <p>Montant de la transaction : @transaction.WalletValue €</p>
                <p>Date de la transaction : @transaction.TransactionDate</p>
            </div>
        }
    }
    else
    {
        <div>Chargement...</div>
    }

    <div class="WalletLimit">
        <h2>Budget</h2>
        <label>
            Limite :
            <select @bind="ViewModel.Type" class="inputLimit" name="type">
                <option value="Dépôt">Dépôt</option>
                <option value="Dépenses">Dépenses</option>
                <option value="Ouvertures">Ouvertures</option>
                <option value="Améliorations">Améliorations</option>
            </select>
        </label>
        <br />
        <label>
            Période :
            <select @bind="ViewModel.Period" class="inputLimit" name="period">
                <option value="Horaire">Horaire</option>
                <option value="Quotidien">Quotidien</option>
                <option value="Hebdomadaire">Hebdomadaire</option>
                <option value="Mensuel">Mensuel</option>
            </select>
        </label>
        <br />
        <label>
            Montant Max :
            <input type="number" @bind="ViewModel.Amount" min="0" step="any" class="inputLimit" name="amount" />
            <br />
            <button class="inputLimit" @onclick="async () => await ViewModel.SaveLimitAsync()">Sauver</button>
        </label>

        <h3>Limites chargées</h3>
        @if (ViewModel.Limits == null)
        {
            <div>Aucune limite chargée</div>
        }
        else if (!ViewModel.Limits.Any())
        {
            <div>Liste vide</div>
        }
        else
        {
            <ul>
                @foreach (var l in ViewModel.Limits)
                {
                    <li>
                        <strong>@(l.LimitType?.LimitTypeName ?? "(sans type)")</strong>
                        — Montant : @(l.LimitAmount.HasValue ? l.LimitAmount.Value.ToString() : "null")
                        — TypeId: @l.LimitTypeId
                        — UserId: @l.UserId
                    </li>
                }
            </ul>
        }
    </div>
}
else
{
    <h1>CHARGEMENT</h1>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }

}