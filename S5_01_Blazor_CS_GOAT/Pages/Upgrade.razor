@page "/upgrade"
@using S5_01_Blazor_CS_GOAT.Layout
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject UpgradeViewModel ViewModel

<div class="upgrade-page">
    <h1>Améliorer vos skins</h1>
    <div class="upgrade-content">
        @if (ViewModel.IsLoading)
        {
            <p>Chargement...</p>
        }
        else
        {
            <p>Ici vous pourrez améliorer vos skins pour obtenir des versions de meilleure qualité.</p>
            <!-- Votre contenu de page ici -->
        }
    </div>
    
    <AuthOverlay />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }
}
