@page "/limits"
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject LimitsViewModel ViewModel

<h1>Limites</h1>

<div class="Limit">
    <div class="Container">
    <div class="form">
            <h2>Budget</h2>
    <label>
        Limite :
        <select class="inputLimit" name="type" @onchange="(e) => ViewModel.SortLimit(ViewModel.Period, e.Value.ToString())">
            <option value=""></option>
            <option value="Dépôt">Dépôt</option>
            <option value="Dépenses">Dépenses</option>
            <option value="Ouvertures">Ouvertures</option>
            <option value="Améliorations">Améliorations</option>
        </select>
    </label>
    <label>
        Période :
        <select class="inputLimit" name="period" @onchange="(e) => ViewModel.SortLimit(e.Value.ToString(), ViewModel.Type)">
            <option value=""></option>
            <option value="Horaire">Horaire</option>
            <option value="Quotidien">Quotidien</option>
            <option value="Hebdomadaire">Hebdomadaire</option>
            <option value="Mensuel">Mensuel</option>
        </select>
    </label>
    <label>
        Montant Max :
        <input type="number" @bind="ViewModel.Amount" min="0" step="any" class="inputLimit" name="amount" />
    </label>
            <button class="inputLimit" @onclick="async () => await ViewModel.SaveLimitAsync()">Mettre à jour la limite</button>
    </div>
    </div>
    <div class="Container">
    <h2>Valeur Actuelle</h2><br/>
    @if (ViewModel.SortedLimits == null)
    {
        <div>Aucune limite sélectionnée</div>
    }
    else if (!ViewModel.SortedLimits.Any())
    {
        <div>Liste vide</div>
    }
    else
    {
        <ul>
            @foreach (var l in ViewModel.SortedLimits)
            {
                <li>
                    <strong>@(l.LimitTypeName ?? "(sans type)")</strong>
                    — Montant : @(l.LimitAmount.ToString() ?? "null")
                </li>
            }
        </ul>
    }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }
}
