@page "/withdrawal-success"
@using S5_01_Blazor_CS_GOAT.Service
@inject NavigationManager NavigationManager
@inject AuthService AuthService

<div style="text-align: center; padding: 50px;">
    <h2>✓ Retrait effectué !</h2>
    <p>Les fonds ont été envoyés à votre carte.</p>
    <p>Redirection en cours...</p>
</div>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(2000);
        
        if (await AuthService.IsLoggedInAsync())
        {
            await AuthService.LoadCurrentUserAsync();
        }
        
        var destination = !string.IsNullOrEmpty(ReturnUrl) ? ReturnUrl : "/wallet";
        NavigationManager.NavigateTo(destination, forceLoad: true);
    }
}