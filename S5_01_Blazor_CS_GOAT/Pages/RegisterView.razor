@page "/register"
@using S5_01_Blazor_CS_GOAT.ViewModels
@inject RegisterViewModel ViewModel

<div class="container-form">
    <div class="form-box">
        <h3>Créer un compte</h3>

        @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
        {
            <div class="alert alert-danger">@ViewModel.ErrorMessage</div>
        }

        <form @onsubmit="async () => await ViewModel.HandleRegisterAsync()" @onsubmit:preventDefault="true">
            <div class="margin-bottom-10">
                <div class="wrapper usr-register">
                    <div class="cta">
                        <label for="login" class="form-label">Identifiant :*</label>
                        <input type="text" id="login" name="login" 
                               class="form-control @(ViewModel.ValidationErrors.ContainsKey("Login") ? "is-invalid" : "")" 
                               @bind="ViewModel.Login" />
                    </div>
                </div>
                @if (ViewModel.ValidationErrors.ContainsKey("Login"))
                {
                    <div class="error-message">@ViewModel.ValidationErrors["Login"]</div>
                }
            </div>

            <div class="margin-bottom-10">
                <div class="wrapper usr-displayname">
                    <div class="cta">
                        <label for="displayName" class="form-label">Nom d'affichage :*</label>
                        <input type="text" id="displayName" name="displayName" 
                               class="form-control @(ViewModel.ValidationErrors.ContainsKey("DisplayName") ? "is-invalid" : "")" 
                               @bind="ViewModel.DisplayName" />
                    </div>
                </div>
                @if (ViewModel.ValidationErrors.ContainsKey("DisplayName"))
                {
                    <div class="error-message">@ViewModel.ValidationErrors["DisplayName"]</div>
                }
            </div>

            <div class="margin-bottom-10">
                <div class="wrapper usr-password">
                    <div class="cta">
                        <label for="password" class="form-label">Mot de passe :*</label>
                        <input type="password" id="password" name="password" 
                               class="form-control @(ViewModel.ValidationErrors.ContainsKey("Password") ? "is-invalid" : "")" 
                               @bind="ViewModel.Password" />
                    </div>
                </div>
                @if (ViewModel.ValidationErrors.ContainsKey("Password"))
                {
                    <div class="error-message">@ViewModel.ValidationErrors["Password"]</div>
                }
            </div>

            <div class="margin-bottom-10">
                <div class="wrapper usr-confirm-password">
                    <div class="cta">
                        <label for="confirmPassword" class="form-label">Confirmer le mot de passe :*</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" 
                               class="form-control @(ViewModel.ValidationErrors.ContainsKey("ConfirmPassword") ? "is-invalid" : "")" 
                               @bind="ViewModel.ConfirmPassword" />
                    </div>
                </div>
                @if (ViewModel.ValidationErrors.ContainsKey("ConfirmPassword"))
                {
                    <div class="error-message">@ViewModel.ValidationErrors["ConfirmPassword"]</div>
                }
            </div>

            <div class="margin-bottom-10">
                <div class="wrapper usr-email">
                    <div class="cta">
                        <label for="email" class="form-label">Email :</label>
                        <input type="email" id="email" name="email" 
                               class="form-control @(ViewModel.ValidationErrors.ContainsKey("Email") ? "is-invalid" : "")" 
                               @bind="ViewModel.Email" />
                    </div>
                </div>
                @if (ViewModel.ValidationErrors.ContainsKey("Email"))
                {
                    <div class="error-message">@ViewModel.ValidationErrors["Email"]</div>
                }
            </div>

            <div class="margin-bottom-10">
                <div class="wrapper usr-phone">
                    <div class="cta">
                        <label for="phone" class="form-label">Téléphone :</label>
                        <input type="text" id="phone" name="phone" 
                               class="form-control @(ViewModel.ValidationErrors.ContainsKey("Phone") ? "is-invalid" : "")" 
                               @bind="ViewModel.Phone" />
                    </div>
                </div>
                @if (ViewModel.ValidationErrors.ContainsKey("Phone"))
                {
                    <div class="error-message">@ViewModel.ValidationErrors["Phone"]</div>
                }
                <small class="form-text text-muted">Un email ou un téléphone est requis</small>
            </div>

            <div class="usr-remember">
                <label class="container" for="remember">
                    <input id="remember" type="checkbox" @bind="ViewModel.Remember">
                    <svg viewBox="0 0 64 64" height="0.9em" width="0.9em">
                        <path d="M 0 16 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 16 L 32 48 L 64 16 V 8 A 8 8 90 0 0 56 0 H 8 A 8 8 90 0 0 0 8 V 56 A 8 8 90 0 0 8 64 H 56 A 8 8 90 0 0 64 56 V 16" pathLength="575.0541381835938" class="path"></path>
                    </svg>
                Se rappeler de moi pendant 30 jours</label>
            </div>

            <div class="wrapper div-submit">
                <button class="cta usr-submit" type="submit" disabled="@ViewModel.IsLoading">
                    <span>@(ViewModel.IsLoading ? "CREATION DU COMPTE..." : "S'INSCRIRE")</span>
                    <span>
                        <svg width="33px" height="22px" viewBox="0 0 66 43" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"><g id="arrow" stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><path class="one" d="M40.1543933,3.89485454 L43.9763149,0.139296592 C44.1708311,-0.0518420739 44.4826329,-0.0518571125 44.6771675,0.139262789 L65.6916134,20.7848311 C66.0855801,21.1718824 66.0911863,21.8050225 65.704135,22.1989893 C65.7000188,22.2031791 65.6958657,22.2073326 65.6916762,22.2114492 L44.677098,42.8607841 C44.4825957,43.0519059 44.1708242,43.0519358 43.9762853,42.8608513 L40.1545186,39.1069479 C39.9575152,38.9134427 39.9546793,38.5968729 40.1481845,38.3998695 C40.1502893,38.3977268 40.1524132,38.395603 40.1545562,38.3934985 L56.9937789,21.8567812 C57.1908028,21.6632968 57.193672,21.3467273 57.0001876,21.1497035 C56.9980647,21.1475418 56.9959223,21.1453995 56.9937605,21.1432767 L40.1545208,4.60825197 C39.9574869,4.41477773 39.9546013,4.09820839 40.1480756,3.90117456 C40.1501626,3.89904911 40.1522686,3.89694235 40.1543933,3.89485454 Z" fill="#FFFFFF"></path><path class="two" d="M20.1543933,3.89485454 L23.9763149,0.139296592 C24.1708311,-0.0518420739 24.4826329,-0.0518571125 24.6771675,0.139262789 L45.6916134,20.7848311 C46.0855801,21.1718824 46.0911863,21.8050225 45.704135,22.1989893 C45.7000188,22.2031791 45.6958657,22.2073326 45.6916762,22.2114492 L24.677098,42.8607841 C24.4825957,43.0519059 24.1708242,43.0519358 23.9762853,42.8608513 L20.1545186,39.1069479 C19.9575152,38.9134427 19.9546793,38.5968729 20.1481845,38.3998695 C20.1502893,38.3977268 20.1524132,38.395603 20.1545562,38.3934985 L36.9937789,21.8567812 C37.1908028,21.6632968 37.193672,21.3467273 37.0001876,21.1497035 C36.9980647,21.1475418 36.9959223,21.1453995 36.9937605,21.1432767 L20.1545208,4.60825197 C19.9574869,4.41477773 19.9546013,4.09820839 20.1480756,3.90117456 C20.1501626,3.89904911 20.1522686,3.89694235 20.1543933,3.89485454 Z" fill="#FFFFFF"></path><path class="three" d="M0.154393339,3.89485454 L3.97631488,0.139296592 C4.17083111,-0.0518420739 4.48263286,-0.0518571125 4.67716753,0.139262789 L25.6916134,20.7848311 C26.0855801,21.1718824 26.0911863,21.8050225 25.704135,22.1989893 C25.7000188,22.2031791 25.6958657,22.2073326 25.6916762,22.2114492 L4.67709797,42.8607841 C4.48259567,43.0519059 4.17082418,43.0519358 3.97628526,42.8608513 L0.154518591,39.1069479 C-0.0424848215,38.9134427 -0.0453206733,38.5968729 0.148184538,38.3998695 C0.150289256,38.3977268 0.152413239,38.395603 0.154556228,38.3934985 L16.9937789,21.8567812 C17.1908028,21.6632968 17.193672,21.3467273 17.0001876,21.1497035 C16.9980647,21.1475418 16.9959223,21.1453995 16.9937605,21.1432767 L0.15452076,4.60825197 C-0.0425130651,4.41477773 -0.0453986756,4.09820839 0.148075568,3.90117456 C0.150162624,3.89904911 0.152268631,3.89694235 0.154393339,3.89485454 Z" fill="#FFFFFF"></path></g></svg>
                    </span> 
                </button>
            </div>
        </form>
        <div class="other-links">
            <p>Vous avez déjà un compte ? <a href="/login">Se connecter</a></p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += (s, e) => StateHasChanged();
    }
}