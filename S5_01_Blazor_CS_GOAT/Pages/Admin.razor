@code {
    private string activeTab = "users";

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        await PromoCodeViewModel.InitializeAsync();
        
        ViewModel.PropertyChanged += (s, e) => InvokeAsync(StateHasChanged);
        PromoCodeViewModel.PropertyChanged += (s, e) => InvokeAsync(StateHasChanged);
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    private async Task ConfirmDeleteUser(int userId, string displayName)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer l'utilisateur '{displayName}' ? Cette action est irréversible."))
        {
            await ViewModel.DeleteUserAsync(userId);
        }
    }

    private async Task ConfirmDeletePromoCode(int promoCodeId, string code)
    {
        if (await JSRuntime.InvokeAsync<bool>("confirm", $"Êtes-vous sûr de vouloir supprimer le code promo '{code}' ? Cette action est irréversible."))
        {
            await PromoCodeViewModel.DeletePromoCodeAsync(promoCodeId);
        }
    }

    private string FormatTimeSpan(TimeSpan timeSpan)
    {
        if (timeSpan.TotalDays >= 1)
        {
            return $"{(int)timeSpan.TotalDays}j";
        }
        else if (timeSpan.TotalHours >= 1)
        {
            return $"{(int)timeSpan.TotalHours}h";
        }
        else if (timeSpan.TotalMinutes >= 1)
        {
            return $"{(int)timeSpan.TotalMinutes}min";
        }
        else
        {
            return $"{(int)timeSpan.TotalSeconds}s";
        }
    }

    public void Dispose()
    {
        if (ViewModel != null)
        {
            ViewModel.PropertyChanged -= (s, e) => InvokeAsync(StateHasChanged);
        }
        if (PromoCodeViewModel != null)
        {
            PromoCodeViewModel.PropertyChanged -= (s, e) => InvokeAsync(StateHasChanged);
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;
}
