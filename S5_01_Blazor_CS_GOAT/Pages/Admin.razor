@page "/admin"
@using S5_01_Blazor_CS_GOAT.ViewModels
@using S5_01_Blazor_CS_GOAT.Pages.Components
@inject AdminViewModel ViewModel
@inject PromoCodeViewModel PromoCodeViewModel
@implements IDisposable

<PageTitle>Administration - CS GOAT</PageTitle>

<div class="admin-container">
    @if (ViewModel.IsLoading)
    {
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Chargement...</p>
        </div>
    }
    else if (ViewModel.Requires2FA && !ViewModel.Is2FAVerified)
    {
        <!-- Écran de vérification 2FA -->
        <div class="twofa-verification">
            <div class="twofa-card">
                <h2>🔐 Vérification 2FA requise</h2>
                <p>Pour accéder au panneau d'administration, veuillez entrer votre code de vérification.</p>
                
                @if (ViewModel.CurrentUser?.TwoFA == Shared.Enum.TwoFAmethod.None)
                {
                    <p class="info-text">Un code a été envoyé à votre téléphone.</p>
                }
                else if (ViewModel.CurrentUser?.TwoFA == Shared.Enum.TwoFAmethod.Phone)
                {
                    <p class="info-text">Un code a été envoyé à votre téléphone.</p>
                }
                else if (ViewModel.CurrentUser?.TwoFA == Shared.Enum.TwoFAmethod.Email)
                {
                    <p class="info-text">Un code a été envoyé à votre adresse e-mail.</p>
                }

                <div class="form-group">
                    <label>Code de vérification</label>
                    <input type="text" 
                           class="form-control" 
                           @bind="ViewModel.TwoFACode" 
                           placeholder="Entrez le code à 6 chiffres"
                           maxlength="6" />
                </div>

                @if (!string.IsNullOrEmpty(ViewModel.TwoFAError))
                {
                    <div class="alert alert-error">@ViewModel.TwoFAError</div>
                }

                <button class="btn btn-primary" 
                        @onclick="async () => await ViewModel.Verify2FAAsync()"
                        disabled="@ViewModel.IsProcessing">
                    @if (ViewModel.IsProcessing)
                    {
                        <span>Vérification...</span>
                    }
                    else
                    {
                        <span>Vérifier</span>
                    }
                </button>

                <button class="btn btn-secondary" @onclick="@(() => ViewModel.NavigateTo("/"))">
                    Annuler
                </button>
            </div>
        </div>
    }
    else
    {
        <!-- Panneau d'administration principal -->
        <div class="admin-header">
            <h1>Panneau d'Administration</h1>
            <p>Bienvenue, @ViewModel.CurrentUser?.DisplayName</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
        {
            <div class="alert alert-error">@ViewModel.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(ViewModel.SuccessMessage))
        {
            <div class="alert alert-success">@ViewModel.SuccessMessage</div>
        }

        @if (!string.IsNullOrEmpty(PromoCodeViewModel.ErrorMessage))
        {
            <div class="alert alert-error">@PromoCodeViewModel.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(PromoCodeViewModel.SuccessMessage))
        {
            <div class="alert alert-success">@PromoCodeViewModel.SuccessMessage</div>
        }

        <!-- Statistiques -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon">👥</div>
                <div class="stat-content">
                    <h3>@ViewModel.TotalUsers</h3>
                    <p>Utilisateurs</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-content">
                    <h3>@($"{ViewModel.TotalRevenue:F2}€")</h3>
                    <p>Portefeuilles totaux</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-content">
                    <h3>@ViewModel.TotalTransactions</h3>
                    <p>Transactions</p>
                </div>
            </div>
        </div>

        <!-- Onglets de navigation -->
        <div class="admin-tabs">
            <button class="tab-button @(activeTab == "users" ? "active" : "")" 
                    @onclick="@(() => SetActiveTab("users"))">
                👥 Utilisateurs
            </button>
            <button class="tab-button @(activeTab == "promocodes" ? "active" : "")" 
                    @onclick="@(() => SetActiveTab("promocodes"))">
                🎫 Codes Promo
            </button>
        </div>

        @if (activeTab == "users")
        {
            <UsersTable ViewModel="@ViewModel" />
        }
        else if (activeTab == "promocodes")
        {
            <PromoCodesTable PromoCodeViewModel="@PromoCodeViewModel" />
        }

        <!-- Bouton retour -->
        <div class="admin-footer">
            <button class="btn btn-secondary" @onclick="@(() => ViewModel.NavigateTo("/"))">
                ← Retour à l'accueil
            </button>
        </div>
    }
</div>

<PromoCodeModal PromoCodeViewModel="@PromoCodeViewModel" 
                ShowCreateModal="@PromoCodeViewModel.ShowCreateModal"
                ShowEditModal="@PromoCodeViewModel.ShowEditModal" />

@code {
    private string activeTab = "users";

    protected override async Task OnInitializedAsync()
    {
        await ViewModel.InitializeAsync();
        await PromoCodeViewModel.InitializeAsync();
        
        ViewModel.PropertyChanged += (s, e) => InvokeAsync(StateHasChanged);
        PromoCodeViewModel.PropertyChanged += (s, e) => InvokeAsync(StateHasChanged);
    }

    private void SetActiveTab(string tab)
    {
        activeTab = tab;
    }

    public void Dispose()
    {
        if (ViewModel != null)
        {
            ViewModel.PropertyChanged -= (s, e) => InvokeAsync(StateHasChanged);
        }
        if (PromoCodeViewModel != null)
        {
            PromoCodeViewModel.PropertyChanged -= (s, e) => InvokeAsync(StateHasChanged);
        }
    }
}
